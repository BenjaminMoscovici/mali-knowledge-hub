          "required": [
            "id",
            "locator",
            "payload.project_id",
            "payload.title",
            "payload.status",
            "payload.board_date_reported"
          ],
          "numeric": []
        }
      ]
    },
    {
      "id": "interventions.local_activities",
      "layer": "interventions",
