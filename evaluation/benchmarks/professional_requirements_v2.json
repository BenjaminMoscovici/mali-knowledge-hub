      "selectors": [
        {
          "equals": {
            "source_type": [
              "delivery_observation"
            ]
          },
          "required": [
            "id",
            "locator",
            "payload.project_id",
            "payload.organization_id",
            "payload.geo_unit_id",
            "payload.unit",
            "reference_start",
            "reference_end"
          ],
          "numeric": [
            "payload.reached"
          ]
