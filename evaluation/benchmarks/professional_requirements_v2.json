  "conversation_requirements": [
    {
      "id": "geography_metric",
      "categories": [
        "geography_metric",
        "geography_path",
        "administrative_level"
      ]
    },
    {
      "id": "sex_metric",
      "categories": [
        "sex_level",
        "sex_geography"
      ]
    },
    {
      "id": "time",
      "categories": [
        "category_period",
        "period_geography",
        "period_change"
      ]
    },
    {
      "id": "entities",
      "categories": [
        "entity_pronoun",
        "status_subset",
        "status_dates"
      ]
    },
    {
      "id": "topic_continuity",
      "categories": [
        "topic_after_social_turn",
        "topic_reset",
        "needs_geography"
      ]
    },
    {
      "id": "false_premise",
      "categories": [
        "unverified_prior_claim"
      ]
