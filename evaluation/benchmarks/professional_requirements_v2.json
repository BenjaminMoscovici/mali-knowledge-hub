{
  "version": "mkh-professional-capability-2.0",
  "purpose": "Overall demonstrated professional capability; 100 means mature, reliable analytical assistance across all fixed evidence layers.",
  "layers": [
    "needs",
    "priorities",
    "actors",
    "interventions",
    "delivery",
    "funding",
    "timelines",
    "results",
    "learning",
    "geography"
  ],
  "coverage_definition": "Each layer has two equally weighted observable requirements. Layer coverage is demonstrated requirements / 2; axis coverage is equal-weight mean of its fixed layers. NOT_DEMONSTRATED is a measured lower-bound exclusion, not proof of absent evidence. Unmeasured inventory or required quality is unavailable.",
  "evidence_requirements": [
    {
      "id": "needs.observations",
      "layer": "needs",
      "definition": "Attributed period-specific displacement and food-security quantities with units, geography and method.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "displacement_stock",
              "food_security_classification"
            ]
          },
          "required": [
            "id",
            "locator",
            "reference_start",
            "reference_end",
            "payload.geography",
            "payload.methodology",
            "payload.unit"
          ],
          "numeric": []
        }
      ]
    },
    {
      "id": "needs.current_multisector",
      "layer": "needs",
      "definition": "Current assessment covering at least two needs sectors with dated local quantitative observations and representativeness.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "needs_assessment"
            ]
          },
          "required": [
            "id",
            "locator",
            "reference_start",
            "reference_end",
            "payload.sector",
            "payload.geography.commune",
            "payload.methodology",
            "payload.representativeness",
            "payload.current_observation"
          ],
          "numeric": [
            "payload.value"
          ]
        }
      ],
      "distinct_by": "payload.sector",
      "minimum_distinct": 2
    },
    {
      "id": "priorities.national",
      "layer": "priorities",
      "definition": "Versioned national strategy excerpts with a page and dated validity.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "knowledge_base_document"
            ],
            "source_family": [
              "Government strategies"
            ]
          },
          "required": [
            "id",
            "locator",
            "payload.document_title",
            "payload.content",
            "version",
            "reference_end"
          ],
          "numeric": []
        }
      ]
    },
    {
      "id": "priorities.local",
      "layer": "priorities",
      "definition": "Local priority or PDSEC evidence with approved administrative identifiers, actions, time period and source page.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "local_priority",
              "pdsec_priority"
            ]
          },
          "required": [
            "id",
            "locator",
            "reference_start",
            "reference_end",
            "payload.geo_unit_id",
            "payload.priority",
            "payload.action"
          ],
          "numeric": []
        }
      ]
    },
    {
      "id": "actors.presence",
      "layer": "actors",
      "definition": "Attributable organizations and sectors at a source-reported local place; presence remains distinct from delivery.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "operational_presence"
            ]
          },
          "required": [
            "id",
            "locator",
            "payload.organization",
            "payload.sector",
            "payload.geography.commune",
            "reference_end"
          ],
          "numeric": []
        }
      ]
    },
    {
      "id": "actors.delivery_links",
      "layer": "actors",
      "definition": "At least two implementers linked by verified IDs to dated local delivery observations.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "delivery_observation"
            ]
          },
          "required": [
            "id",
            "locator",
            "payload.organization_id",
            "payload.project_id",
            "payload.geo_unit_id",
            "reference_start",
            "reference_end"
          ],
          "numeric": [
            "payload.reached"
          ]
        }
      ],
      "distinct_by": "payload.organization_id",
      "minimum_distinct": 2
    },
    {
      "id": "interventions.profiles",
      "layer": "interventions",
      "definition": "Dated source project identifiers, titles and reported lifecycle status.",
      "selectors": [
        {
          "equals": {
            "source_type": [
              "development_project"
            ]
