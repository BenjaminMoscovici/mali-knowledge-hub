  "axes": {
    "Evidence accuracy": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × mean(deterministic factual-grounding pass rate, min(citation-ID validity, claim citation entailment), 1 − unsupported-or-contradicted claim rate)",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Geographic intelligence": {
      "layers": [
        "geography"
      ],
      "quality_formula": "100 × mean(deterministic geographic-discipline pass rate, (mean judge geographic discipline − 1)/4)",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Source coverage": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × mean(required relevant source-family presence rate, (mean judge evidence completeness − 1)/4)",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Joined analysis": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × mean((joined-case mean cross-source synthesis − 1)/4, (joined-case mean inference discipline − 1)/4, (joined-case mean evidence-gap handling − 1)/4)",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Analytical usefulness": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × mean((mean decision usefulness − 1)/4, (mean evidence completeness − 1)/4, (mean writing quality − 1)/4, (mean inference discipline − 1)/4)",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Conversational ability": {
      "layers": [],
      "quality_formula": "100 × mean(follow-up correct-interpretation rate, 1 − unnecessary-clarification rate, follow-up factual-grounding proxy rate); requires every frozen sequence/turn to have been attempted",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Performance": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × [0.45 × min(1,5/complex median seconds) + 0.25 × min(1,15/complex P95 seconds) + 0.15 × explicit route-assertion pass rate + 0.15 × explicit zero-call-budget pass rate]",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    },
    "Cost efficiency": {
      "layers": [
        "needs",
        "priorities",
        "actors",
        "interventions",
        "delivery",
        "funding",
        "timelines",
        "results",
        "learning",
        "geography"
      ],
      "quality_formula": "100 × min(1, (normalized complex-query decision-usefulness points/90) × (0.003/complex median USD)); all complex success costs must be priced",
      "formula": "quality_points × demonstrated_coverage_fraction × availability_fraction"
    }
  },
  "latency_targets_seconds": {
    "quick": 1.0,
    "balanced": 8.0,
    "deep": 15.0
  },
  "evidence_adjustment": "V1 quality × assessable material claims / all material claims, then multiply by coverage and availability. Missing important evidence lowers completeness and typed layer coverage. Historical sources count only in bounded basic requirements, not current operational readiness.",
  "conversation_adjustment": "V1 quality × share of seven fixed conversational requirements demonstrated on every expected turn, including grounding proxy, then availability. Full original suite required; source facts must still be retrieved.",
  "performance_adjustment": "Requires all six explicitly tagged cold/warm Quick/Balanced/Deep cohorts. Quality=100×mean(min(1, mode target / all-attempt client median) × cohort availability)×mean(route pass rate, zero-call pass rate). Then multiply by professional layer coverage and overall availability. Missing cache-state observations make this axis unavailable.",
  "cost_adjustment": "Quality=min(V1 cost-efficiency points,V1 analytical usefulness points), then multiply by professional layer coverage and availability; unpriced complex usage is unavailable.",
  "maturity_bands": [
    [
      0,
      20,
      "very limited / prototype"
    ],
    [
      20,
      40,
      "basic"
    ],
    [
      40,
      60,
      "useful but materially incomplete"
    ],
    [
      60,
      75,
      "strong"
    ],
    [
      75,
      90,
      "advanced"
    ],
    [
      90,
      100,
      "near-mature professional capability"
    ]
  ],
  "protected_gates": "Unchanged, separate, never averaged. No total radar score. Historical comparisons require identical formulas, requirements, suite and evaluators."
}
